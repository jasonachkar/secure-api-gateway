# Environment variable reference for local development.
# Copy to `.env` and fill in real values. See src/config/env.ts for full validation rules -
# in production (NODE_ENV=production) the app refuses to boot with placeholder secrets,
# an unauthenticated Redis, a wildcard CORS_ORIGIN, or Swagger UI left enabled.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── Redis (rate limiting, token/session state, audit log, API keys) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Dev-safe default: no password, since local Redis isn't exposed beyond docker-compose's
# internal network. REQUIRED in production - the app will fail to start without it.
REDIS_PASSWORD=
REDIS_DB=0
# Set true for managed Redis that requires TLS (e.g. Azure Cache for Redis) - the
# Terraform deployment sets this automatically when REDIS_HOST is the Azure hostname.
REDIS_TLS=false

# ── JWT (auth) ───────────────────────────────────────────────────────────────
# Generate RS256 keys: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=./keys/private.pem
JWT_PUBLIC_KEY=./keys/public.pem
# For HS256 (simpler, fine for local dev): JWT_SECRET=<32+ random chars, never the literal placeholder below>
# JWT_SECRET=your-super-secret-key-min-256-bits-long-change-me
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── Rate limiting (all Redis-backed, correct across multiple gateway instances) ─
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60000
RATE_LIMIT_USER_MAX=200
RATE_LIMIT_USER_WINDOW=60000
RATE_LIMIT_APIKEY_MAX=500
RATE_LIMIT_APIKEY_WINDOW=60000

# ── Security ─────────────────────────────────────────────────────────────────
# Explicit origin allowlist - never "*" in production (the app enforces this at startup)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Dev-only placeholder - the app refuses to boot with this exact value when NODE_ENV=production.
# Generate a real one with: openssl rand -base64 32
COOKIE_SECRET=your-cookie-secret-min-32-chars-long-change-in-production
BCRYPT_ROUNDS=12

# ── Account security ─────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# ── Upstream services (proxy target) ─────────────────────────────────────────
UPSTREAM_REPORTS_URL=http://mock-service:4000
UPSTREAM_TIMEOUT=5000
UPSTREAM_RETRY_ATTEMPTS=2

# SSRF protection: hostname allowlist for anything the gateway proxies to.
# Requests are also DNS-resolved and pinned to a validated, non-private IP before
# the connection is opened - see src/lib/httpClient.ts.
ALLOWED_UPSTREAM_HOSTS=mock-service,api.example.com
# Local-dev-only: Docker Compose's mock-service resolves to a private container IP,
# which the private-IP check above would otherwise correctly block. Leave false
# outside Docker Compose - the app refuses to boot with this =true in production.
SSRF_ALLOW_PRIVATE_IPS=false

# Circuit breaker protecting upstream calls (src/lib/circuitBreaker.ts)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ── Features ─────────────────────────────────────────────────────────────────
# Defaults to true in dev/test and false in production unless set explicitly here.
# The app refuses to boot with this =true when NODE_ENV=production.
ENABLE_SWAGGER=true

# Enables demo/sample-data endpoints (e.g. seeding test incidents). Leave false outside demos.
DEMO_MODE=false

# ── Request limits ───────────────────────────────────────────────────────────
BODY_LIMIT=1048576
REQUEST_TIMEOUT=30000

# ── Ingestion adapters (optional - enable by setting the corresponding value) ─
# CLOUDWATCH_LOG_GROUP=
# GCP_LOGGING_PROJECT=
# AZURE_SENTINEL_WORKSPACE=

# ── Storage (optional - only used by the ingestion pipeline if set) ──────────
# POSTGRES_URL=

# ── Third-party integrations (optional) ──────────────────────────────────────
# ABUSEIPDB_API_KEY=
