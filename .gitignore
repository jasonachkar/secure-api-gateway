# Dependencies
node_modules/
# package-lock.json - Keep this file tracked (needed for npm ci in Docker builds)
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino-*.log
audit-logs.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns

# Docker
# .dockerignore - Keep this file tracked (needed for deployments)

# Keys (NEVER commit private keys)
*.pem
*.key
!*.example.key
keys/
secrets/

# Redis dumps
dump.rdb

# Terraform
terraform/.schema-probe/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
plan.out
terraform/plan.out
crash.log
crash.*.log
# Real backend/tfvars files (copied from the tracked .example templates) - never commit
# real state backend config or environment-specific variable values
terraform/backend.tf
terraform/environments/*.tfvars
!terraform/environments/*.tfvars.example
