{
  "name": "secure-api-gateway",
  "version": "1.0.0",
  "description": "Production-grade API Gateway with JWT auth, RBAC, rate limiting, and OWASP API security mitigations",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-fixtures.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "seed": "bash scripts/dev-seed.sh",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "tf:init": "terraform -chdir=terraform init",
    "tf:plan": "terraform -chdir=terraform plan -var-file=environments/dev.tfvars",
    "tf:apply": "terraform -chdir=terraform apply -var-file=environments/dev.tfvars"
  },
  "keywords": [
    "api-gateway",
    "security",
    "jwt",
    "rbac",
    "rate-limiting",
    "owasp",
    "fastify",
    "typescript"
  ],
  "author": "Security Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1094.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@google-cloud/logging": "^11.3.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "brace-expansion": "^5.0.8"
  }
}
